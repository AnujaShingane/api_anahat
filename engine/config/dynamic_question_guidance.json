  "delivery_policy": {
    "_note": "Set with DYNAMIC_QUESTION_DELIVERY.",
    "auto": {
      "description": "AI-only mode. A generated question that passes every backend check is shown to the patient directly.",
      "use_kb_question_instead_when": [
        "the latest patient answer or opening concern touches a sensitive topic (sensitive_topics)",
        "the generated question touches a sensitive topic",
        "the latest answer is not safety-CLEAR, or an AMBER alert is unacknowledged, or a RED escalation is active",
        "the model fails, times out, returns invalid JSON or CANNOT_GENERATE",
        "any backend validation fails (structure, chakra/diagnostic words, leading, unknown ids, duplicate, low confidence)"
      ],
      "flag_only": [
        "ambiguity_with_3_or_more_interpretations (indicator maps to 3+ chakras): delivered, flagged in therapist_review_reasons for later audit"
      ]
    },
    "therapist_review": {
      "description": "Every generated question is returned with delivery_status PENDING_THERAPIST_REVIEW. The therapist approves, edits or rejects it (POST /sessions/{id}/questions/{question_id}/review). An answer to a pending question is refused. Reject switches to the KB fallback question.",
      "review_reasons_reported": [
        "sensitive_topic",
        "sensitive_topic_in_patient_context",
        "ambiguity_with_3_or_more_interpretations"
      ]
    }
  }
