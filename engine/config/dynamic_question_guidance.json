{
  "_schema_version": "1.0",
  "_status": "ENGINEERING DEFAULTS - REQUIRES THERAPIST / DOMAIN VALIDATION BEFORE PRODUCTION",
  "_purpose": "Policy for the adaptive (LLM-worded) question generator. This file deliberately lives OUTSIDE knowledge_base/ANAHAT_KnowledgeBase_v3 so the hash-verified KB stays untouched. It contains NO chakra meanings, indicator mappings or symptom lists: those are always read at runtime from the KB (quadrant_question_bank.json, symptom/emotion/behaviour_to_chakra.json, chakra_disambiguation_questions_v3.json, chakra_master.json).",
  "kb_sources_used_at_runtime": {
    "quadrants_and_attributes": "structured/quadrant_question_bank.json",
    "canonical_indicators": [
      "structured/symptom_to_chakra.json",
      "structured/emotion_to_chakra.json",
      "structured/behaviour_to_chakra.json"
    ],
    "competing_interpretations": "structured/assessment/chakra_disambiguation_questions_v3.json (answer_options labels are sent to the model as patient-safe themes, chakra names removed)",
    "fallback_theme_for_single_chakra_indicators": "structured/chakra_master.json core_themes",
    "selection_priority": "structured/assessment/assessment_engine_design_v3.json adaptive_questioning.selection_priority",
    "questioning_principles": "rag/assessment_technique/foundational_questioning_principles.md (open questions, avoid 'why', avoid leading and yes/no questions)"
  },
