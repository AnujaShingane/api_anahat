  "goals_owned_by_structured_follow_up": {
    "_note": "currentness and intensity are asked by the existing deep-dive follow-up with fixed answer options (Mild/Moderate/Severe, current/historical). The generator does not duplicate them for a signal whose follow-up was already presented.",
    "goals": [
      "current_or_historical",
      "intensity"
    ]
  },
  "limits": {
    "min_question_chars": 12,
    "max_question_chars": 220,
    "max_question_words": 40,
    "min_generation_confidence": 0.5,
    "duplicate_similarity_threshold": 0.8,
    "max_signals_in_context": 4,
    "max_asked_questions_in_context": 15,
    "max_reference_questions": 3,
    "max_latest_answer_chars": 600,
    "max_concern_chars": 600,
    "min_question_words": 6
  },
