APP_ENV=development

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

QDRANT_COLLECTION=anahat_knowledge

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

CHUNK_SIZE=800
CHUNK_MAX_SIZE=1000
CHUNK_OVERLAP=120

RETRIEVAL_TOP_K=10

KB_PATH=./knowledge_base/ANAHAT_KnowledgeBase_v3

LLM_PROVIDER=mistral
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=llama3:latest
LOCAL_LLM_KEEP_ALIVE=30m
LLM_FALLBACK_PROVIDERS=local
# Mistral (OpenAI-compatible API). Choose a model id from your Mistral console that supports structured output.
MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_TOTAL_TIMEOUT_SECONDS=180

# ---- Adaptive (LLM-worded) quadrant questions ----
# The KB/RAG question is still chosen first; the LLM words ONE follow-up from the patient's
# latest answer. Any failure or rejected output falls back to the KB question.
DYNAMIC_QUESTIONS_ENABLED=true
# Providers allowed to see patient words for question generation (comma list, in order).
# local = Ollama (LOCAL_LLM_URL). Add mistral if wanted. gemini/openrouter are refused
# unless DYNAMIC_QUESTION_ALLOW_REMOTE_PROVIDERS=true.
DYNAMIC_QUESTION_PROVIDERS=local
DYNAMIC_QUESTION_ALLOW_REMOTE_PROVIDERS=false
# Optional separate Ollama model for questions (default: LOCAL_LLM_MODEL), e.g. llama3.2:3b
DYNAMIC_QUESTION_MODEL=
DYNAMIC_QUESTION_TEMPERATURE=0.3
DYNAMIC_QUESTION_TIMEOUT_SECONDS=30
# auto = AI-only (validated questions go straight to the patient)
# therapist_review = every generated question waits for POST /sessions/{id}/questions/{qid}/review
DYNAMIC_QUESTION_DELIVERY=auto
DYNAMIC_QUESTION_GUIDANCE_PATH=./config/dynamic_question_guidance.json
