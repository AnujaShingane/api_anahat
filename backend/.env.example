PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5174
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173

SESSION_SECRET=change-me-to-a-long-random-string

# PostgreSQL (structured: users, profiles, appointments, payments, slots)
PG_URI=postgres://postgres:postgres@localhost:5432/harmony

# MongoDB (unstructured: chats, files, prescriptions, tracks, and all the
# frontend-2 extended data — patients, sessions, conversations, mood entries, etc.)
MONGO_URI=mongodb://localhost:27017/harmony

# Google OAuth (Google Cloud Console -> Credentials) — optional, login/signup
# work fine without these; the Google button on the frontend just shows a
# "not configured" message until they're set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Fixed admin account (seeded, cannot be registered through the UI)
ADMIN_EMAIL=admin@harmony.app
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Harmony Admin

# ANAHAT AI Engine (separate FastAPI service). The backend is the ONLY client
# of the engine; the browser never talks to it. Keep the engine on localhost
# or a private network.
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_TIMEOUT_MS=120000
# Path to the engine's structured KB (read-only) used by Nadika.AI question suggestions.
# Defaults to ../ANAHAT_AI_ENGINE/knowledge_base/ANAHAT_KnowledgeBase_v3/structured
# (removed) the backend no longer reads KB files; the engine serves all KB content
